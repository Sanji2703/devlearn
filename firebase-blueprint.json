{
  "entities": {
    "users": {
      "title": "UserProfile",
      "description": "User profile and learning preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth user ID" },
        "displayName": { "type": "string", "maxLength": 100, "description": "User full name" },
        "email": { "type": "string", "maxLength": 200, "description": "User email address" },
        "photoURL": { "type": "string", "maxLength": 500, "description": "User avatar" },
        "dailyGoalMinutes": { "type": "number", "description": "Daily study target in minutes" },
        "createdAt": { "type": "string", "maxLength": 50, "description": "Creation timestamp" }
      },
      "required": ["uid", "email"]
    },
    "modules": {
      "title": "LearningModule",
      "description": "User-defined module for C, C++, Python, or SQL",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "subject": { "type": "string", "enum": ["c", "cpp", "python", "sql"] },
        "title": { "type": "string", "maxLength": 200 },
        "order": { "type": "number" },
        "objective": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["not_started", "in_progress", "completed", "needs_review", "mastered"] },
        "notes": { "type": "string", "maxLength": 10000 },
        "resources": { "type": "string", "maxLength": 20000, "description": "JSON string of resource items" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "subject", "title", "status"]
    },
    "exercises": {
      "title": "Exercise",
      "description": "User-defined coding exercise attached to a module",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "subject": { "type": "string", "enum": ["c", "cpp", "python", "sql"] },
        "moduleId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "statement": { "type": "string", "maxLength": 10000 },
        "link": { "type": "string", "maxLength": 1000 },
        "driveFileId": { "type": "string", "maxLength": 200 },
        "driveFileName": { "type": "string", "maxLength": 200 },
        "solutionNotes": { "type": "string", "maxLength": 10000 },
        "difficulty": { "type": "string", "enum": ["facile", "moyen", "difficile"] },
        "estimatedMinutes": { "type": "number" },
        "status": { "type": "string", "enum": ["not_started", "in_progress", "completed", "needs_review"] },
        "scheduledActivityId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "subject", "moduleId", "title", "difficulty", "status"]
    },
    "activities": {
      "title": "ScheduleActivity",
      "description": "Schedule events including courses, commutes, obligations, and study sessions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "type": { "type": "string", "enum": ["course", "appointment", "commute", "personal", "rest", "study_available", "study_session"] },
        "subject": { "type": "string", "maxLength": 20 },
        "moduleId": { "type": "string", "maxLength": 128 },
        "exerciseId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "startTime": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$" },
        "endTime": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$" },
        "durationMinutes": { "type": "number" },
        "isFixed": { "type": "boolean" },
        "isCompleted": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 2000 },
        "aiProposed": { "type": "boolean" },
        "aiRationale": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "title", "type", "date", "startTime", "endTime", "durationMinutes"]
    },
    "sessions": {
      "title": "StudySession",
      "description": "Logged concentration/pomodoro sessions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "subject": { "type": "string", "enum": ["c", "cpp", "python", "sql"] },
        "moduleId": { "type": "string", "maxLength": 128 },
        "exerciseId": { "type": "string", "maxLength": 128 },
        "targetMinutes": { "type": "number" },
        "durationMinutes": { "type": "number" },
        "completedAt": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "subject", "durationMinutes", "completedAt"]
    },
    "reviews": {
      "title": "DailyReview",
      "description": "Daily recap and learning reflections",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "plannedMinutes": { "type": "number" },
        "actualMinutes": { "type": "number" },
        "completedCount": { "type": "number" },
        "pendingCount": { "type": "number" },
        "difficulties": { "type": "string", "maxLength": 5000 },
        "carryOverNotes": { "type": "string", "maxLength": 5000 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "date"]
    },
    "settings": {
      "title": "UserSettings",
      "description": "User preferences and global learning parameters",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "dailyStudyTargetMinutes": { "type": "number" },
        "preferredSubject": { "type": "string", "maxLength": 20 },
        "defaultSessionDuration": { "type": "number" },
        "notificationsEnabled": { "type": "boolean" },
        "soundEnabled": { "type": "boolean" },
        "autoPostponeUnfinished": { "type": "boolean" },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId"]
    },
    "materials": {
      "title": "LearningMaterial",
      "description": "Uploaded study files and learning resources metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "fileName": { "type": "string", "maxLength": 255 },
        "fileType": { "type": "string", "maxLength": 100 },
        "fileSize": { "type": "number" },
        "storagePath": { "type": "string", "maxLength": 500 },
        "downloadUrl": { "type": "string", "maxLength": 2000 },
        "subject": { "type": "string", "maxLength": 20 },
        "moduleId": { "type": "string", "maxLength": 128 },
        "exerciseId": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 1000 },
        "storageType": { "type": "string", "enum": ["firebase_storage", "drive", "local_storage"] },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "fileName", "fileType", "fileSize"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User profile document"
    },
    "/modules/{moduleId}": {
      "schema": "modules",
      "description": "User learning modules"
    },
    "/exercises/{exerciseId}": {
      "schema": "exercises",
      "description": "User coding exercises"
    },
    "/activities/{activityId}": {
      "schema": "activities",
      "description": "Schedule events and study activities"
    },
    "/sessions/{sessionId}": {
      "schema": "sessions",
      "description": "Logged concentration sessions"
    },
    "/reviews/{reviewId}": {
      "schema": "reviews",
      "description": "Daily reviews and balance"
    },
    "/settings/{settingsId}": {
      "schema": "settings",
      "description": "User preferences document"
    },
    "/materials/{materialId}": {
      "schema": "materials",
      "description": "Uploaded learning documents and file references"
    }
  }
}

